<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Crafta Creatives | Digital & Media Agency" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Modak&family=Rubik+Bubbles&family=Rubik+Spray+Paint&family=Rubik+Wet+Paint&display=swap" rel="stylesheet" media="print" onload="this.media='all'" onerror="this.remove()">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Modak&family=Rubik+Bubbles&family=Rubik+Spray+Paint&family=Rubik+Wet+Paint&display=swap" rel="stylesheet">
    </noscript>

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application.jsx' %>
  </head>

  <body class="bg-agencyDark text-white">
    <%= yield %>
  </body>
</html>
